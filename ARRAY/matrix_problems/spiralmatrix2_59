class Solution {
public:
    vector<vector<int>> generateMatrix(int n) {
        
        int m = n;
        int top =0;
        int left = 0;
        int right= m-1;
        int bottom = n-1;
        vector<vector<int>>matrix(m ,vector<int>(n));
        int cnt=1;
        while(top<=bottom && left<=right){
            
            for(int i = left ; i<=right ; i++){
                matrix[top][i]= cnt++;

            }
            top++;

            for(int i = top ; i<=bottom ;i++){
                matrix[i][right]=cnt++;
            }
            right--;
            if(top<=bottom){
                for(int i =right ; i>=left;i--){
                    matrix[bottom][i]=cnt++;
                }
            }
            bottom--;
            if(left<=right){
                for(int i = bottom ; i>=top ; i--){
                    matrix[i][left]=cnt++;

                }

            }
            left++;


        }
        return matrix;
  
        
    }
};
