class Solution {
public:
    int subarraysDivByK(vector<int>& nums, int k) {
        unordered_map<int,int>mp;
        int current=0;
        int cnt=0;
        mp[0]=1;
        for(int i = 0 ; i<nums.size(); i++){
            current= current+nums[i];
            int remainder= (current%k+k)%k;
            if(mp.find(remainder)!=mp.end()){
                cnt+=mp[remainder];
            }
            mp[remainder]++;
        }
        return cnt;
        
    }
};
